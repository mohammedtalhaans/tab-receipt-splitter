{
  "name": "tab-receipt-splitter",
  "private": true,
  "version": "1.0.0",
  "description": "Split the receipt. Not the bill equally. A private, client-side receipt splitter.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/sync-ocr-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:core": "node --experimental-strip-types scripts/test-core.mjs",
    "prebuild": "node scripts/sync-ocr-assets.mjs && node scripts/sync-license-notices.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:dist": "node scripts/check-dist.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "verify": "npm run typecheck && npm test && npm run check:privacy && npm run build && npm run check:dist",
    "assets:ocr": "node scripts/sync-ocr-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.7",
    "@tesseract.js-data/eng": "1.0.0",
    "canvas-confetti": "1.9.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "motion": "12.23.12",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "3.3.1",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "26.6.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "playwright-core": "1.55.1"
  }
}
